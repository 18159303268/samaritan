{
  "name": "ai-chat",
  "version": "1.2.1",
  "description": "Samaritan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.laopeng.aichat",
    "productName": "Samaritan",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/tray.png", "to": "tray.png" }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  }
}
